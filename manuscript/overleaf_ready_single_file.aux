\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Architecture of the proposed \textbf  {AST-Route} Framework: Layer 1 parses an input SQL query into a 9-dimensional structural and selectivity vector ($\text  {CSCI}$, join count, window specifications, \texttt  {UNNEST}, predicate selectivity $\sigma (q)$, tree depth, AST nodes, and CTEs); Layer 2 and Layer 3 drive multi-output cost and resource prediction (latency, energy, memory, and FinOps cost); and Layer 4 dispatches the query to the optimal engine across DuckDB (CPU OLAP), Polars/DataFusion (Rust Arrow engines), CUDA GPU, and Google BigQuery (Cloud OLAP).}}{5}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:proposed_ast_framework}{{1}{5}{Architecture of the proposed \textbf {AST-Route} Framework: Layer 1 parses an input SQL query into a 9-dimensional structural and selectivity vector ($\text {CSCI}$, join count, window specifications, \texttt {UNNEST}, predicate selectivity $\sigma (q)$, tree depth, AST nodes, and CTEs); Layer 2 and Layer 3 drive multi-output cost and resource prediction (latency, energy, memory, and FinOps cost); and Layer 4 dispatches the query to the optimal engine across DuckDB (CPU OLAP), Polars/DataFusion (Rust Arrow engines), CUDA GPU, and Google BigQuery (Cloud OLAP)}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces End-to-end six-phase experimental validation workflow of the \textbf  {AST-Route} framework, illustrating TPC-H multi-layout data provisioning ($\text  {SF}=1, 10, 30, \text  {and } 100\text  { GB}$), 75-query factorial synthesis (25 canonical seeds $\times $ 3 selectivity horizons) alongside official TPC-H Q1--Q22, \texttt  {SQLGlot} static AST profiling, six-engine execution across four computing paradigms, non-parametric seed-cluster statistical inference, and cryptographic SHA-256 verification.}}{6}{figure.caption.2}\protected@file@percent }
\newlabel{fig:experimental_workflow}{{2}{6}{End-to-end six-phase experimental validation workflow of the \textbf {AST-Route} framework, illustrating TPC-H multi-layout data provisioning ($\text {SF}=1, 10, 30, \text {and } 100\text { GB}$), 75-query factorial synthesis (25 canonical seeds $\times $ 3 selectivity horizons) alongside official TPC-H Q1--Q22, \texttt {SQLGlot} static AST profiling, six-engine execution across four computing paradigms, non-parametric seed-cluster statistical inference, and cryptographic SHA-256 verification}{figure.caption.2}{}}
